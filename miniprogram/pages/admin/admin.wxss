.todo {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}
.red {
  color: #b3261e;
}
.menu {
  background: #fff;
  border-radius: 12rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.badge {
  background: #2f5d3a;
  color: #fff;
  font-size: 24rpx;
  min-width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 999rpx;
  padding: 0 12rpx;
}
.badge.red {
  background: #b3261e;
}
