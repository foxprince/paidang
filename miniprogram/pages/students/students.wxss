.block {
  width: 100%;
  margin-bottom: 24rpx;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.name {
  font-size: 32rpx;
  font-weight: 600;
}
.level {
  font-size: 24rpx;
  color: #2f5d3a;
}
.meta {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #8a8a8a;
}
.btn {
  font-size: 28rpx;
  line-height: 2.4;
  border-radius: 8rpx;
  background: #eee;
  color: #1a1a1a;
}
.btn.primary {
  background: #2f5d3a;
  color: #fff;
}
button::after {
  border: none;
}
