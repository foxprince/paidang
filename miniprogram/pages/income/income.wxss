.monthbar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
}
.mini {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  font-size: 32rpx;
  background: #fff;
  border-radius: 50%;
  color: #1a1a1a;
}
.month {
  font-size: 32rpx;
  font-weight: 600;
}
.hero {
  background: #1a1a1a;
  color: #fafaf8;
  border-radius: 12rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}
.amount {
  font-size: 64rpx;
  font-weight: 700;
  display: block;
}
.sub {
  font-size: 26rpx;
  opacity: 0.7;
}
.section {
  margin: 24rpx 0 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}
.row {
  display: flex;
  justify-content: space-between;
}
.amount-sm {
  font-weight: 600;
}
button::after {
  border: none;
}
