<view class="page">
  <view wx:if="{{coach}}">
    <view class="card">
      <view class="row"><text class="name">{{coach.nickname}}</text><text class="status">{{statusText}}</text></view>
      <view class="meta">{{coach.title}} · {{coach.home_court}}</view>
      <view class="meta">¥{{coach.priceYuan}}/小时 · 污点 {{coach.demerits}} · 订单 {{bookings}} · 评价 {{reviews}}</view>
      <view class="meta" wx:if="{{coach.verified}}">平台验证徽章已发放</view>
      <view class="claimrow" wx:if="{{coach.claim_code}}">
        <text class="meta">认领码：<text class="code">{{coach.claim_code}}</text></text>
        <button class="btn mini" bindtap="onCopyCode">复制</button>
      </view>
    </view>
    <view class="bio" wx:if="{{coach.bio}}">{{coach.bio}}</view>
    <video wx:if="{{coach.video_url}}" class="video" src="{{coach.video_url}}" controls show-center-play-btn></video>

    <view class="section">审核</view>
    <view class="actions">
      <button class="btn primary" data-v="1" bindtap="onVerify">通过</button>
      <button class="btn" data-v="0" bindtap="onVerify">驳回下架</button>
    </view>

    <view class="section">状态</view>
    <view class="actions">
      <button class="btn" data-s="suspended" bindtap="onStatus">下架</button>
      <button class="btn danger" data-s="banned" bindtap="onStatus">封号</button>
      <button class="btn primary" data-s="active" bindtap="onStatus">恢复</button>
    </view>
  </view>
</view>
