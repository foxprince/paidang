.card { background: #fff; border-radius: 12rpx; padding: 28rpx; margin-bottom: 20rpx; }
.row { display: flex; justify-content: space-between; align-items: center; }
.name { font-size: 34rpx; font-weight: 600; }
.status { font-size: 24rpx; color: #2f5d3a; }
.meta { margin-top: 6rpx; font-size: 26rpx; color: #8a8a8a; }
.bio { margin-bottom: 20rpx; }
.video { width: 100%; height: 400rpx; border-radius: 12rpx; margin-bottom: 20rpx; background: #000; }
.claimrow { display: flex; justify-content: space-between; align-items: center; margin-top: 8rpx; }
.code { font-weight: 700; color: #2f5d3a; letter-spacing: 4rpx; }
.mini { font-size: 24rpx; line-height: 2; padding: 0 24rpx; margin: 0; }
.section { margin: 28rpx 0 16rpx; font-size: 28rpx; font-weight: 600; }
.actions { display: flex; gap: 16rpx; margin-bottom: 8rpx; }
.btn { flex: 1; font-size: 28rpx; line-height: 2.4; border-radius: 8rpx; background: #eee; color: #1a1a1a; }
.btn.primary { background: #2f5d3a; color: #fff; }
.btn.danger { background: #b3261e; color: #fff; }
button::after { border: none; }
