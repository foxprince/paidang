.done {
  padding: 120rpx 0;
  text-align: center;
}
.done-title {
  font-size: 40rpx;
  font-weight: 700;
}
.done-sub {
  margin-top: 12rpx;
  color: #8a8a8a;
}
.section {
  margin: 24rpx 0 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.dates {
  white-space: nowrap;
  margin-bottom: 8rpx;
}
.date {
  display: inline-block;
  padding: 14rpx 24rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  background: #fff;
  border-radius: 999rpx;
  color: #555;
}
.date.on {
  background: #1a1a1a;
  color: #fff;
}
.slotgrid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.slot {
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  background: #fff;
  border-radius: 8rpx;
}
.slot.on {
  background: #2f5d3a;
  color: #fff;
}
.field {
  margin-bottom: 16rpx;
}
.input {
  background: #fff;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.coderow {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.code {
  flex: 1;
}
.small {
  font-size: 26rpx;
  line-height: 2.6;
  padding: 0 28rpx;
  white-space: nowrap;
}
.hint {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 24rpx;
}
.block {
  width: 100%;
}
.btn {
  font-size: 28rpx;
  line-height: 2.4;
  border-radius: 8rpx;
  background: #eee;
  color: #1a1a1a;
}
.btn.primary {
  background: #2f5d3a;
  color: #fff;
}
button::after {
  border: none;
}
button[disabled] {
  opacity: 0.5;
}
