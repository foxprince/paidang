.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.time {
  font-size: 34rpx;
  font-weight: 600;
}
.status {
  font-size: 24rpx;
  color: #2f5d3a;
}
.name {
  margin-top: 8rpx;
  color: #555;
}
.actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}
.btn {
  flex: 1;
  font-size: 28rpx;
  line-height: 2.4;
  border-radius: 8rpx;
  background: #eee;
  color: #1a1a1a;
}
.btn.primary {
  background: #2f5d3a;
  color: #fff;
}
button::after {
  border: none;
}
