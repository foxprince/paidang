.field { margin-bottom: 20rpx; }
.label { display: block; font-size: 26rpx; color: #555; margin-bottom: 8rpx; }
.input { background: #fff; border-radius: 8rpx; padding: 20rpx 24rpx; font-size: 28rpx; }
.area { min-height: 120rpx; }
.block { width: 100%; margin-top: 16rpx; }
.btn { font-size: 28rpx; line-height: 2.4; border-radius: 8rpx; background: #eee; color: #1a1a1a; }
.btn.primary { background: #2f5d3a; color: #fff; }
button::after { border: none; }
.done { padding: 60rpx 0; text-align: center; }
.done-title { font-size: 40rpx; font-weight: 700; }
.done-sub { margin: 12rpx 0 32rpx; color: #8a8a8a; font-size: 26rpx; }
.code { font-size: 72rpx; font-weight: 700; letter-spacing: 16rpx; color: #2f5d3a; margin-bottom: 32rpx; }
