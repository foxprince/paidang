.section {
  margin: 24rpx 0 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.section:first-child {
  margin-top: 0;
}
.hint {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 16rpx;
}
.field {
  margin-bottom: 20rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 8rpx;
}
.input {
  background: #fff;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
.area {
  min-height: 120rpx;
}
.dayrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.dayname {
  width: 80rpx;
  font-size: 28rpx;
}
.dayinput {
  flex: 1;
}
.block {
  width: 100%;
  margin-top: 16rpx;
}
.btn {
  font-size: 28rpx;
  line-height: 2.4;
  border-radius: 8rpx;
  background: #eee;
  color: #1a1a1a;
}
.btn.primary {
  background: #2f5d3a;
  color: #fff;
}
.btn.danger {
  background: #b3261e;
  color: #fff;
}
button::after {
  border: none;
}
.claimlink { margin-top: 32rpx; text-align: center; font-size: 26rpx; color: #8a8a8a; }
