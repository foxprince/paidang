.section { margin: 24rpx 0 16rpx; font-size: 28rpx; font-weight: 600; }
.section:first-child { margin-top: 0; }
.grid { display: flex; gap: 16rpx; margin-bottom: 8rpx; }
.cell { flex: 1; background: #fff; border-radius: 12rpx; padding: 28rpx 16rpx; text-align: center; }
.num { font-size: 40rpx; font-weight: 700; display: block; }
.num.red { color: #b3261e; }
.lbl { font-size: 24rpx; color: #8a8a8a; }
.card { background: #fff; border-radius: 12rpx; padding: 20rpx 28rpx; margin: 16rpx 0; }
.row { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 28rpx; }
