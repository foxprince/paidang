# 复制成 .env 后填真实值（.env 永不提交）
# 本地开发
DATABASE_URL=postgres://user:pass@localhost:5432/paidang?sslmode=disable
JWT_SECRET=换成随机字符串
WECHAT_APPID=你的小程序AppID
WECHAT_SECRET=你的小程序AppSecret
# 订阅消息模板 ID（微信公众平台 → 订阅消息 → 选用模板后填）
WECHAT_TPL_NEW_BOOKING=
WECHAT_TPL_BOOKING_RESULT=
WECHAT_TPL_BOOKING_DONE=
PORT=8080
